.build/
.swiftpm/
*.xcodeproj
# The LIBRARY's resolved file stays out: a library pins nothing for its consumers. The
# BENCHMARK package's is tracked (Benchmarks/.gitignore un-ignores it): its numbers are
# quoted against specific Yams, ZippyJSON and swift-syntax versions, and a reproducer six
# months from now must resolve the same ones.
/Package.resolved
.DS_Store

# Generated corpus. Regenerate with:  cd Benchmarks && swift run -c release CorpusGen
# Deterministic and seeded, so the files are reproducible from the generator.
# Tracked decision: the GENERATOR is the artifact, not its output
# (docs/PERFORMANCE.md §12.2 — "publish the generator, not just the files").
Benchmarks/Corpus/files/
Benchmarks/Corpus/manifest.json

# Experiment intermediates
Experiments/**/*.ll
Experiments/**/*.s
Experiments/**/ct.txt
