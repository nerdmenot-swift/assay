nonisolated static let __assayDeclaredKeys: Set<String> = ["id", "p"]

nonisolated public func _assayEncodeMembers(
    into w: inout Assay.JSONWriter,
    into sink: inout Assay.IssueSink,
    at path: inout [Assay.PathStep]
) {
        w._key(separated: ",\"id\":")
        w.write(self.id.uuidString)
        w._key(separated: ",\"p\":")
        w.beginObject()
            w._key(separated: ",\"q\":")
            w.write(self.q)

            w._key(separated: ",\"r\":")
            w.beginObject()
                w._key(separated: ",\"s\":")
                if let __e2 = self.s {
                    w.write(__e2)
