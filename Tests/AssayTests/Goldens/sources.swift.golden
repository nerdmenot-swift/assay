        let __c1 = source.stringColumn("b", 1)
        let __n1 = source.nulls("b", 1)
        if __c1 == nil {
            Assay._assayColumnMissing(&sink, path, "b", "string")
            __columnMissing = true
        }
        let __c2 = source.doubleColumn("c", 2)
        let __n2 = source.nulls("c", 2)
        let __c3 = source.int64Column("n", 3)
        let __t3: [String]? = __c3 == nil ? source.stringColumn("n", 3) : nil
        let __n3 = source.nulls("n", 3)
        if __c3 == nil, __t3 == nil {
            Assay._assayColumnMissing(&sink, path, "n", "int")
            __columnMissing = true
        }
        let __c4 = Assay._assayFetchColumn(Date.self, from: source, "when", 4)
        let __t4: [String]? = __c4 == nil ? source.stringColumn("when", 4) : nil
        let __d4: [Double]? = __c4 == nil && __t4 == nil ? source.doubleColumn("when", 4) : nil
        let __n4 = source.nulls("when", 4)
        if __c4 == nil, __t4 == nil, __d4 == nil {
            Assay._assayColumnMissing(&sink, path, "when", "Date")
            __columnMissing = true
        }
        if __columnMissing { return [] }
    var __out: [GoldenSources] = []
    __out.reserveCapacity(source.rowCount)

    // The row index reaches every issue through the sink, not through a path built
    // per row: `sink.add` inserts it, cold, only when something is reported.
    for __r in 0..<source.rowCount {
        sink._enterRow(__r, depth: path.count)
            var __f0: Int? = nil
            if let __col0 = __c0, __r < __col0.count,
               !Assay._assayIsNullAt(__n0, __r) {
                guard let __x0 = Int(exactly: __col0[__r]) else {
                    Assay._assayRowOverflow(&sink, path, "a", __col0[__r])
                    continue
                }
                __f0 = __x0
            }

            var __f1: String? = nil
            if let __col1 = __c1, __r < __col1.count,
               !Assay._assayIsNullAt(__n1, __r) {
                __f1 = __col1[__r]
            }

            var __f2: Double? = nil
            if let __col2 = __c2, __r < __col2.count,
               !Assay._assayIsNullAt(__n2, __r) {
                __f2 = __col2[__r]
            }

            var __f3: Int? = nil
            if let __col3 = __c3, __r < __col3.count,
               !Assay._assayIsNullAt(__n3, __r) {
                guard let __x3 = Int(exactly: __col3[__r]) else {
                    Assay._assayRowOverflow(&sink, path, "n", __col3[__r])
                    continue
                }
                __f3 = __x3
            } else if let __txt3 = __t3, __r < __txt3.count,
               !Assay._assayIsNullAt(__n3, __r) {
                guard let __x3 = Assay._assayCoerceInt64(__txt3[__r]) else {
                    Assay._assayRowMismatch(&sink, path, "n", "integer", __txt3[__r]); continue
                }
                guard let __y3 = Int(exactly: __x3) else {
                    Assay._assayRowOverflow(&sink, path, "n", __x3); continue
                }
                __f3 = __y3
            }

            var __f4: Date? = nil
            if let __col4 = __c4, __r < __col4.count,
               !Assay._assayIsNullAt(__col4.nulls, __r) {
                __f4 = Date(assayColumn: __col4, row: __r, metadata: __col4.metadata)
            } else if let __txt4 = __t4, __r < __txt4.count,
               !Assay._assayIsNullAt(__n4, __r) {
                guard let __s4 = Assay.RawValue.string(__txt4[__r])._assayDate(&sink, path, "when", Assay.DateFormat.defaultFormats) else { continue }
