            } else if let __dbl4 = __d4, __r < __dbl4.count,
                      !Assay._assayIsNullAt(__n4, __r) {
                guard let __s4 = Assay.RawValue.double(__dbl4[__r])._assayDate(&sink, path, "when", Assay.DateFormat.defaultFormats) else { continue }
                __f4 = Date(timeIntervalSince1970: __s4)
